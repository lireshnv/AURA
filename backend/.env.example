# AURA backend configuration.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every secret below is read from the environment - nothing is hard-coded in
# the source, and no real credential appears in this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production
# In production the app REFUSES TO START without a strong AURA_JWT_SECRET.
AURA_ENV=development

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AURA_JWT_SECRET=
AURA_JWT_ALGORITHM=HS256
AURA_ACCESS_TOKEN_MINUTES=60

# Account lockout after repeated failed logins.
AURA_MAX_FAILED_LOGINS=5
AURA_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset -> local SQLite file (~/.aura/aura_core.db), so the app runs with no
# database server. Set a Postgres DSN to switch; no code change is needed.
#   DATABASE_URL=postgresql+psycopg2://aura:password@localhost:5432/aura
DATABASE_URL=

# ---------------------------------------------------------------------------
# CORS - comma separated. Never use "*".
# ---------------------------------------------------------------------------
AURA_CORS_ORIGINS=http://localhost:6969,http://127.0.0.1:6969

# ---------------------------------------------------------------------------
# Bootstrap admin - created once at startup ONLY if no admin user exists yet.
# Never overwrites a real admin's password on restart.
# ---------------------------------------------------------------------------
AURA_ADMIN_EMAIL=
AURA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Google OAuth 2.0 ("Continue with Google")
# Create a client at https://console.cloud.google.com/apis/credentials
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on that
# client. Server-side only - the client secret never reaches the browser.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:6970/api/auth/google/callback
# Where the backend redirects the browser after a successful Google login.
AURA_FRONTEND_URL=http://localhost:6969

# ---------------------------------------------------------------------------
# Session cookie signing (separate from AURA_JWT_SECRET so either can rotate
# independently). Minimum 32 characters in production.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# OTP login. With no provider configured, OTPs are logged to the backend
# console only (never returned to the browser) - fine for local development,
# not for anything real. Wire a real SMTP/SMS provider before deployment.
# ---------------------------------------------------------------------------
OTP_PROVIDER_KEY=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
AURA_RATE_LIMIT=1
AURA_AUTH_RATE_LIMIT=10/minute
AURA_API_RATE_LIMIT=120/minute

# ---------------------------------------------------------------------------
# Optional integrations
# Absent by default. Each service reports "not configured" rather than
# failing, and no feature silently degrades without saying so.
# ---------------------------------------------------------------------------

# ElevenLabs - Speech-to-Text for the Emotion Analysis voice pipeline
# (microphone -> transcript -> text/tone analysis). REQUIRED for that
# transcript; without it speech-to-text reports "unavailable" rather than
# failing silently. Server-side only: never expose this key to the browser.
ELEVENLABS_API_KEY=

# Groq - powers the AURA AI Companion (chat + Whisper voice transcription).
# REQUIRED for the companion; without it the companion reports "not configured"
# rather than failing silently.
# Server-side only: this key must never reach the browser. The frontend calls
# AURA's own /api/chat, and only the backend calls Groq.
GROQ_API_KEY=

# Companion model overrides (optional). Defaults match the original chatbot.
AURA_CHAT_MODEL=openai/gpt-oss-120b
AURA_TRANSCRIBE_MODEL=whisper-large-v3
AURA_CHAT_MAX_TOKENS=1024
AURA_CHAT_TIMEOUT=45

# Gemini - used ONLY for natural-language explanation of already-computed
# signals. It never produces emotion probabilities, transcripts or risk scores.
# NOTE: enabling this sends derived signals to a third party. Treat as a
# privacy decision, not just a config change.
GEMINI_API_KEY=
